{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-10-19 00:00:00.000000",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!--\n  SIBYL - SALES INVOICE (Jinja, wkhtmltopdf-safe: literal colours, real tables only)\n  Shipped by sibyl_app (print_format/sibyl_sales_invoice). Based on the \"Sales INV\" design;\n  adds the company NTN line and a Payment Status section (receipts date-wise with running\n  balance and balance receivable, as on the print date) from\n  sibyl_app.invoice_payments.get_invoice_payment_status.\n  Enable Print Settings > \"Repeat Header and Footer\" for the pinned page footer.\n-->\n<style>\n  @page { size: A4; margin: 10mm 12mm; }\n\n  .print-format {\n    font-family: \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif;\n    font-size: 9.5pt;\n    line-height: 1.5;\n    color: #1f2430;\n    -webkit-print-color-adjust: exact;\n  }\n  * { -webkit-box-sizing: border-box; box-sizing: border-box; }\n  table { border-collapse: collapse; width: 100%; }\n\n  /* Frappe's built-in print CSS applies `!important` borders to every\n     <table>/<td> inside .print-format (this is why simple overrides\n     don't stick). These tables are pure layout scaffolding, not data\n     grids, so their borders are reset here \u2014 scoped + !important so\n     it reliably wins. Any border we DO want (item rows, the divider\n     above Grand Total, the Bill-To/Ship-To underline, the meta-box\n     spacers) is re-declared further down, also with !important. */\n  .print-format .header-table, .print-format .header-table td,\n  .print-format .meta-table, .print-format .meta-table td,\n  .print-format .party-table, .print-format .party-table td,\n  .print-format .footer-table, .print-format .footer-table td,\n  .print-format .bank-table, .print-format .bank-table td,\n  .print-format .totals-section, .print-format .totals-section td,\n  .print-format .totals-table, .print-format .totals-table tr, .print-format .totals-table td,\n  .print-format .sign-table, .print-format .sign-table td {\n    border: none !important;\n  }\n\n  /* Frappe's print CSS also includes a responsive rule that collapses\n     table/tr/td into stacked block boxes below a certain viewport\n     width \u2014 and wkhtmltopdf's rendering canvas can trip that\n     breakpoint, which is why labels and amounts were landing on\n     separate lines instead of the same row. Forcing real table\n     display back, per element type, fixes it. */\n  .print-format table.totals-table,\n  .print-format table.meta-table,\n  .print-format table.party-table,\n  .print-format table.header-table,\n  .print-format table.footer-table,\n  .print-format table.bank-table,\n  .print-format table.sign-table,\n  .print-format table.totals-section,\n  .print-format table.items-table {\n    display: table !important;\n  }\n  .print-format .totals-table tr,\n  .print-format .meta-table tr,\n  .print-format .party-table tr,\n  .print-format .header-table tr,\n  .print-format .footer-table tr,\n  .print-format .bank-table tr,\n  .print-format .sign-table tr,\n  .print-format .totals-section tr,\n  .print-format .items-table tr {\n    display: table-row !important;\n  }\n  .print-format .totals-table td,\n  .print-format .meta-table td,\n  .print-format .party-table td,\n  .print-format .header-table td,\n  .print-format .footer-table td,\n  .print-format .bank-table td,\n  .print-format .sign-table td,\n  .print-format .totals-section td,\n  .print-format .items-table td,\n  .print-format .items-table th {\n    display: table-cell !important;\n  }\n  .print-format .items-table thead {\n    display: table-header-group !important;\n  }\n  .print-format .items-table tbody {\n    display: table-row-group !important;\n  }\n\n  /* Palette \u2014 literal values only (no CSS variables; unsupported\n     by patched-Qt WebKit in wkhtmltopdf 0.12.x):\n     ink #1f2430 \u00b7 muted #6b7280 \u00b7 rule #d9dce1 \u00b7\n     rule-strong #1f2430 \u00b7 accent #14213d \u00b7 accent-soft #eef1f6 */\n\n  /* ================= HEADER (header-html) ================= */\n  #header-html { margin: 0 0 8px 0; }\n  .header-table td { vertical-align: top; padding: 0; }\n  .header-table .h-left { width: 58%; }\n  .header-table .h-right { width: 42%; text-align: right; }\n\n  .company-logo { max-height: 44px; max-width: 220px; margin-bottom: 6px; }\n  .company-name { font-size: 13pt; font-weight: 700; color: #14213d; margin: 0 0 2px 0; }\n  .company-meta { font-size: 8pt; color: #6b7280; line-height: 1.45; max-width: 320px; }\n\n  .doc-title {\n    font-size: 20pt; font-weight: 800; color: #14213d;\n    letter-spacing: 1px; text-transform: uppercase; margin: 0 0 3px 0;\n  }\n  .doc-subtitle { font-size: 8pt; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px; }\n\n  .header-rule { border-bottom: 2px solid #1f2430; padding-bottom: 8px; margin-bottom: 8px; }\n\n  .status-badge {\n    display: inline-block; padding: 3px 10px; margin-top: 6px;\n    font-size: 7.6pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;\n    -webkit-border-radius: 2px; border-radius: 2px; border: 1px solid #14213d; color: #14213d;\n  }\n  .status-badge.paid { border-color: #1a7f37; color: #1a7f37; }\n  .status-badge.overdue { border-color: #b42318; color: #b42318; }\n\n  /* meta strip */\n  .meta-table { margin-bottom: 8px; }\n  .meta-table td {\n    padding: 6px 10px; background: #eef1f6;\n    border-right: 3px solid #ffffff !important; vertical-align: top; width: 25%;\n  }\n  .meta-table td:last-child { border-right: none !important; }\n  .meta-label { font-size: 7pt; text-transform: uppercase; letter-spacing: 0.6px; color: #6b7280; margin-bottom: 2px; }\n  .meta-value { font-size: 9.5pt; font-weight: 700; color: #1f2430; }\n\n  /* bill to / ship to */\n  .party-table td { width: 50%; vertical-align: top; padding-right: 14px; }\n  .party-table td:last-child { padding-right: 0; padding-left: 14px; }\n  .party-label {\n    font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.6px; color: #6b7280;\n    border-bottom: 1px solid #d9dce1; padding-bottom: 3px; margin-bottom: 5px; font-weight: 700;\n  }\n  .party-name { font-size: 10.5pt; font-weight: 700; color: #1f2430; margin-bottom: 2px; }\n  .party-detail { font-size: 8.7pt; color: #3b3f4a; line-height: 1.5; }\n  .party-detail div { margin-bottom: 1px; }\n  .party-detail.muted { color: #6b7280; }\n\n  /* ================= FOOTER (footer-html) ================= */\n  #footer-html { width: 100%; }\n  .footer-rule { border-top: 1px solid #d9dce1; padding-top: 5px; }\n  .footer-table td { font-size: 7.4pt; color: #6b7280; vertical-align: middle; }\n  .footer-table .f-left { width: 70%; }\n  .footer-table .f-right { width: 30%; text-align: right; }\n\n  /* ================= BODY / ITEMS ================= */\n  .items-table { margin-top: 4px; }\n  .items-table thead th {\n    background: #14213d; color: #ffffff; font-size: 7.6pt; text-transform: uppercase;\n    letter-spacing: 0.4px; padding: 7px 6px; text-align: left; font-weight: 700;\n  }\n  .items-table thead th.num { text-align: right; }\n  .items-table thead th.center { text-align: center; }\n  .items-table tbody td { padding: 6px 6px; border-bottom: 1px solid #d9dce1; font-size: 8.8pt; vertical-align: top; }\n  .items-table tbody tr.even td { background: #fafbfc; }\n  .items-table td.num { text-align: right; white-space: nowrap; }\n  .items-table td.center { text-align: center; }\n  .item-name { font-weight: 600; color: #1f2430; }\n  .item-desc { font-size: 7.8pt; color: #6b7280; margin-top: 1px; }\n\n  /* ================= TOTALS (dedicated 2-col table) ================= */\n  .totals-section { margin-top: 10px; }\n  .totals-section td { vertical-align: top; }\n  .totals-section .t-left { width: 58%; padding-right: 16px; }\n  .totals-section .t-right { width: 42%; }\n\n  .totals-table td { padding: 3px 0; font-size: 9pt; }\n  .totals-table td.label { text-align: left; }\n  .totals-table td.amount { text-align: right; white-space: nowrap; padding-left: 10px; }\n  .totals-table tr.subtle td { color: #6b7280; font-size: 8.4pt; }\n  .totals-table tr.grand td {\n    border-top: 2px solid #1f2430 !important; font-size: 11.5pt; font-weight: 800;\n    color: #14213d; padding-top: 7px;\n  }\n  .totals-table tr.due td { font-weight: 700; }\n\n  .amount-words {\n    margin-top: 10px; padding: 7px 10px; background: #eef1f6;\n    font-size: 8.3pt; border-left: 3px solid #14213d;\n  }\n  .amount-words b { color: #1f2430; }\n\n  .info-block-title {\n    font-size: 7.6pt; text-transform: uppercase; letter-spacing: 0.5px;\n    color: #6b7280; font-weight: 700; margin-bottom: 4px;\n  }\n  .terms-box { font-size: 8.3pt; color: #3b3f4a; line-height: 1.55; white-space: pre-wrap; }\n  .bank-table td { font-size: 8.3pt; padding: 2px 0; }\n  .bank-table td.k { color: #6b7280; width: 38%; }\n  .bank-table td.v { font-weight: 600; color: #1f2430; }\n\n  /* ================= SIGNATURE ================= */\n  .sign-table { margin-top: 30px; }\n  .sign-table td { width: 50%; vertical-align: bottom; }\n  .sign-table td.right { text-align: right; }\n  .sign-line { border-top: 1px solid #1f2430; width: 70%; margin-top: 26px; padding-top: 4px; font-size: 8pt; color: #6b7280; }\n  .sign-table td.right .sign-line { margin-left: 30%; }\n\n  /* ================= PAYMENT STATUS ================= */\n  .print-format .pay-head-table, .print-format .pay-head-table td,\n  .print-format .pay-summary, .print-format .pay-summary td { border: none !important; }\n  .print-format table.pay-head-table, .print-format table.pay-table, .print-format table.pay-summary { display: table !important; }\n  .print-format .pay-head-table tr, .print-format .pay-table tr, .print-format .pay-summary tr { display: table-row !important; }\n  .print-format .pay-head-table td, .print-format .pay-table td, .print-format .pay-table th, .print-format .pay-summary td { display: table-cell !important; }\n  .print-format .pay-table thead { display: table-header-group !important; }\n  .print-format .pay-table tbody { display: table-row-group !important; }\n\n  .pay-section { margin-top: 12px; page-break-inside: avoid; }\n  .print-format .pay-head-table { border-bottom: 2px solid #1f2430 !important; margin-bottom: 6px; }\n  .pay-head-table td { vertical-align: bottom; padding: 0 0 4px 0; }\n  .pay-title { font-size: 9pt; font-weight: 800; color: #14213d; text-transform: uppercase; letter-spacing: 0.6px; }\n  .pay-asof { font-size: 7.8pt; color: #6b7280; margin-top: 1px; }\n  .pay-head-table td.r { text-align: right; }\n  .pay-badge {\n    display: inline-block; padding: 3px 10px; font-size: 7.6pt; font-weight: 700;\n    text-transform: uppercase; letter-spacing: 0.5px;\n    -webkit-border-radius: 2px; border-radius: 2px; border: 1px solid #14213d; color: #14213d;\n  }\n  .pay-badge.paid { border-color: #1a7f37; color: #1a7f37; }\n  .pay-badge.overdue { border-color: #b42318; color: #b42318; }\n  .pay-note { font-size: 8.4pt; color: #3b3f4a; margin: 2px 0 7px 0; }\n  .pay-note.paid { color: #1a7f37; }\n  .pay-note.overdue { color: #b42318; }\n\n  .print-format .pay-table thead th {\n    background: #eef1f6; color: #1f2430; font-size: 7.4pt; text-transform: uppercase;\n    letter-spacing: 0.4px; padding: 6px 6px; text-align: left; font-weight: 700;\n    border: none !important; border-bottom: 1px solid #1f2430 !important;\n  }\n  .print-format .pay-table thead th.num { text-align: right; }\n  .print-format .pay-table tbody td { padding: 4px 6px; font-size: 8.6pt; vertical-align: top; border: none !important; border-bottom: 1px solid #d9dce1 !important; }\n  .pay-table td.num { text-align: right; white-space: nowrap; }\n  .pay-table tr.opening td { color: #6b7280; }\n  .pay-table td.empty { color: #6b7280; text-align: center; padding: 9px 6px; }\n\n  .pay-summary { margin-top: 6px; }\n  .pay-summary td { padding: 2px 6px; font-size: 9pt; }\n  .pay-summary td.sp { width: 58%; }\n  .pay-summary td.label { text-align: left; }\n  .pay-summary td.amount { text-align: right; white-space: nowrap; }\n  .print-format .pay-summary tr.bal td.label, .print-format .pay-summary tr.bal td.amount { border-top: 2px solid #1f2430 !important; font-size: 10.5pt; font-weight: 800; color: #14213d; padding-top: 6px; }\n  .print-format .pay-summary tr.bal.overdue td.amount { color: #b42318; }\n  .print-format .pay-summary tr.bal.paid td.amount { color: #1a7f37; }\n  .sign-table { margin-top: 14px; }\n  .sign-line { margin-top: 20px; }\n</style>\n\n<!-- =========================================================\n     HEADER \u2014 repeats on every page when \"Repeat Header and\n     Footer\" is enabled in Print Settings.\n     ========================================================= -->\n<div {% if print_settings.repeat_header_footer %} id=\"header-html\" class=\"visible-pdf\" {% endif %}>\n  <div class=\"header-rule\">\n    <table class=\"header-table\">\n      <tr>\n        <td class=\"h-left\">\n          <img class=\"company-logo\" src=\"https://portal.sibyl.pk/files/logo-full-500.png\" alt=\"{{ doc.company }}\">\n          <div class=\"company-name\">{{ doc.company }}</div>\n          <div class=\"company-meta\">\n            {% if doc.company_address %}\n            {%- set addr = frappe.get_doc(\"Address\", doc.company_address) %}\n            {{ addr.address_line1 or \"\" }}{% if addr.address_line2 %}, {{ addr.address_line2 }}{% endif %}\n            <br>{{ addr.city or \"\" }}{% if addr.state %}, {{ addr.state }}{% endif %} {{ addr.pincode or \"\" }}\n            <br>{% if addr.phone %}Tel: {{ addr.phone }}{% endif %}{% if addr.email_id %} &nbsp;|&nbsp; {{ addr.email_id }}{% endif %}\n            {% endif %}\n            {%- set company_tax_id = frappe.db.get_value(\"Company\", doc.company, \"tax_id\") %}\n            {% if company_tax_id %}<br>NTN: {{ company_tax_id }}{% endif %}\n          </div>\n        </td>\n        <td class=\"h-right\">\n          <div class=\"doc-title\">Sales Invoice</div>\n          <div class=\"doc-subtitle\">Original for Recipient</div>\n          <span class=\"status-badge {% if doc.status == 'Paid' %}paid{% elif doc.status == 'Overdue' %}overdue{% endif %}\">\n            {{ doc.status }}\n          </span>\n        </td>\n      </tr>\n    </table>\n  </div>\n\n  <table class=\"meta-table\">\n    <tr>\n      <td>\n        <div class=\"meta-label\">Invoice No.</div>\n        <div class=\"meta-value\">{{ doc.name }}</div>\n      </td>\n      <td>\n        <div class=\"meta-label\">Invoice Date</div>\n        <div class=\"meta-value\">{{ frappe.utils.formatdate(doc.posting_date) }}</div>\n      </td>\n      <td>\n        <div class=\"meta-label\">Due Date</div>\n        <div class=\"meta-value\">{{ frappe.utils.formatdate(doc.due_date) if doc.due_date else \"&mdash;\" }}</div>\n      </td>\n      <td>\n        <div class=\"meta-label\">PO / Reference</div>\n        <div class=\"meta-value\">{{ doc.po_no or \"&mdash;\" }}</div>\n      </td>\n    </tr>\n  </table>\n\n  <table class=\"party-table\">\n    <tr>\n      <td>\n        <div class=\"party-label\">Bill To</div>\n        <div class=\"party-name\">{{ doc.customer_name or doc.customer }}</div>\n        <div class=\"party-detail\">\n          {%- set fallback_addr_name = frappe.db.get_value(\"Dynamic Link\", {\"link_doctype\": \"Customer\", \"link_name\": doc.customer, \"parenttype\": \"Address\"}, \"parent\") %}\n          {%- set addr_name = doc.customer_address or fallback_addr_name %}\n          {% if addr_name %}\n          {%- set cust_addr = frappe.get_doc(\"Address\", addr_name) %}\n          {{ cust_addr.address_line1 or \"\" }}{% if cust_addr.address_line2 %}, {{ cust_addr.address_line2 }}{% endif %}\n          <br>{{ cust_addr.city or \"\" }}{% if cust_addr.state %}, {{ cust_addr.state }}{% endif %} {{ cust_addr.pincode or \"\" }}\n          {% if cust_addr.country %}<br>{{ cust_addr.country }}{% endif %}\n          {% elif doc.address_display %}\n          {{ doc.address_display }}\n          {% endif %}\n        </div>\n      </td>\n      <td>\n        <div class=\"party-label\">Contact Details</div>\n        <div class=\"party-detail\">\n          {%- set fallback_contact_name = frappe.db.get_value(\"Dynamic Link\", {\"link_doctype\": \"Customer\", \"link_name\": doc.customer, \"parenttype\": \"Contact\"}, \"parent\") %}\n          {%- set contact_name = doc.contact_person or fallback_contact_name %}\n          {% if contact_name %}\n          {%- set cust_contact = frappe.get_doc(\"Contact\", contact_name) %}\n          <div class=\"party-name\" style=\"font-size:9.5pt;\">{{ cust_contact.first_name or \"\" }}{% if cust_contact.last_name %} {{ cust_contact.last_name }}{% endif %}</div>\n          {% if cust_contact.mobile_no %}<div>Mobile: {{ cust_contact.mobile_no }}</div>{% endif %}\n          {% if cust_contact.phone %}<div>Tel: {{ cust_contact.phone }}</div>{% endif %}\n          {% else %}\n          {% if doc.contact_display %}<div class=\"party-name\" style=\"font-size:9.5pt;\">{{ doc.contact_display }}</div>{% endif %}\n          {% if doc.contact_email %}<div>Email: {{ doc.contact_email }}</div>{% endif %}\n          {% if doc.contact_mobile %}<div>Mobile: {{ doc.contact_mobile }}</div>{% endif %}\n          {% if not doc.contact_display and not doc.contact_email and not doc.contact_mobile %}\n          <div class=\"muted\">No contact on record</div>\n          {% endif %}\n          {% endif %}\n          {% if doc.tax_id %}<div>NTN / Tax ID: {{ doc.tax_id }}</div>{% endif %}\n        </div>\n      </td>\n    </tr>\n  </table>\n</div>\n\n<!-- =========================================================\n     FOOTER \u2014 repeats at the physical bottom of every page when\n     \"Repeat Header and Footer\" is enabled. class=\"page\" /\n     \"topage\" are wkhtmltopdf's native placeholders.\n     ========================================================= -->\n<div {% if print_settings.repeat_header_footer %} id=\"footer-html\" class=\"visible-pdf\" {% endif %}>\n  <div class=\"footer-rule\">\n    <table class=\"footer-table\">\n      <tr>\n        <td class=\"f-left\">{{ doc.company }} &nbsp;&bull;&nbsp; Sales Invoice {{ doc.name }}</td>\n        <td class=\"f-right\">Page <span class=\"page\"></span> of <span class=\"topage\"></span></td>\n      </tr>\n    </table>\n  </div>\n</div>\n\n<!-- =========================================================\n     BODY \u2014 plain flow content (not wrapped in a table), so\n     wkhtmltopdf's page-break and column-alignment handling for\n     the items table and totals stays predictable.\n     ========================================================= -->\n\n<table class=\"items-table\">\n  <thead>\n    <tr>\n      <th style=\"width:4%;\" class=\"center\">#</th>\n      <th style=\"width:36%;\">Item &amp; Description</th>\n      <th style=\"width:8%;\" class=\"center\">Qty</th>\n      <th style=\"width:8%;\" class=\"center\">UOM</th>\n      <th style=\"width:14%;\" class=\"num\">Rate</th>\n      <th style=\"width:10%;\" class=\"center\">Disc %</th>\n      <th style=\"width:20%;\" class=\"num\">Amount</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for row in doc.items %}\n    <tr class=\"{{ 'even' if loop.index is even else 'odd' }}\">\n      <td class=\"center\">{{ row.idx }}</td>\n      <td>\n        <div class=\"item-name\">{{ row.item_name }}</div>\n        {% if row.item_code and row.item_code != row.item_name %}\n          <div class=\"item-desc\">Code: {{ row.item_code }}</div>\n        {% endif %}\n        {% if row.description and row.description != row.item_name %}\n          <div class=\"item-desc\">{{ row.description | striptags }}</div>\n        {% endif %}\n      </td>\n      <td class=\"center\">{{ row.qty | round | int }}</td>\n      <td class=\"center\">{{ row.uom or row.stock_uom }}</td>\n      <td class=\"num\">{{ row.get_formatted(\"rate\", doc) }}</td>\n      <td class=\"center\">{{ \"%.2f\"|format(row.discount_percentage) if row.discount_percentage else \"&mdash;\" }}</td>\n      <td class=\"num\">{{ row.get_formatted(\"amount\", doc) }}</td>\n    </tr>\n    {% endfor %}\n  </tbody>\n</table>\n\n<!-- ================= TOTALS ================= -->\n<table class=\"totals-section\">\n  <tr>\n    <td class=\"t-left\">\n\n      {% if doc.terms %}\n      <div class=\"info-block-title\">Terms &amp; Conditions</div>\n      <div class=\"terms-box\">{{ doc.terms | striptags }}</div>\n      {% endif %}\n\n      {% if bank_details %}\n      <div class=\"info-block-title\" style=\"margin-top:12px;\">Payment Details</div>\n      <table class=\"bank-table\">\n        <tr><td class=\"k\">Bank</td><td class=\"v\">{{ bank_details.bank_name }}</td></tr>\n        <tr><td class=\"k\">Account Title</td><td class=\"v\">{{ bank_details.account_title }}</td></tr>\n        <tr><td class=\"k\">Account No. / IBAN</td><td class=\"v\">{{ bank_details.iban }}</td></tr>\n      </table>\n      {% endif %}\n\n    </td>\n    <td class=\"t-right\">\n      <table class=\"totals-table\">\n        <tr>\n          <td class=\"label\">Subtotal</td>\n          <td class=\"amount\">{{ doc.get_formatted(\"total\") }}</td>\n        </tr>\n        {% if doc.discount_amount %}\n        <tr class=\"subtle\">\n          <td class=\"label\">Discount {% if doc.additional_discount_percentage %}({{ doc.additional_discount_percentage }}%){% endif %}</td>\n          <td class=\"amount\">- {{ doc.get_formatted(\"discount_amount\") }}</td>\n        </tr>\n        {% endif %}\n        {% for tax in doc.taxes %}\n        {% if tax.tax_amount %}\n        <tr class=\"subtle\">\n          <td class=\"label\">{{ tax.description }}</td>\n          <td class=\"amount\">{{ tax.get_formatted(\"tax_amount\", doc) }}</td>\n        </tr>\n        {% endif %}\n        {% endfor %}\n        {% if doc.rounding_adjustment %}\n        <tr class=\"subtle\">\n          <td class=\"label\">Round Off</td>\n          <td class=\"amount\">{{ doc.get_formatted(\"rounding_adjustment\") }}</td>\n        </tr>\n        {% endif %}\n        <tr class=\"grand\">\n          <td class=\"label\">Grand Total</td>\n          <td class=\"amount\">{{ doc.get_formatted(\"grand_total\") }}</td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n</table>\n\n{% if doc.in_words %}\n<div class=\"amount-words\">\n  Amount in Words: <b>{{ doc.in_words }}</b>\n</div>\n{% endif %}\n\n<!-- ================= PAYMENT STATUS ================= -->\n{%- set pay = get_invoice_payment_status(doc) if doc.docstatus == 1 else None %}\n{% if pay %}\n<div class=\"pay-section\">\n  <table class=\"pay-head-table\">\n    <tr>\n      <td>\n        <div class=\"pay-title\">Payment Status</div>\n        <div class=\"pay-asof\">As on {{ frappe.utils.formatdate(pay.as_on) }}</div>\n      </td>\n      <td class=\"r\">\n        <span class=\"pay-badge {{ pay.tone }}\">{{ pay.title }}{% if pay.overdue_days %} &middot; {{ pay.overdue_days }} day{{ \"s\" if pay.overdue_days != 1 }} overdue{% endif %}</span>\n      </td>\n    </tr>\n  </table>\n  <div class=\"pay-note {{ pay.tone }}\">{{ pay.label }}</div>\n\n  <table class=\"pay-table\">\n    <thead>\n      <tr>\n        <th style=\"width:5%;\">#</th>\n        <th style=\"width:14%;\">Date</th>\n        <th style=\"width:19%;\">Receipt No.</th>\n        <th style=\"width:16%;\">Mode</th>\n        <th style=\"width:16%;\">Reference</th>\n        <th style=\"width:15%;\" class=\"num\">Received</th>\n        <th style=\"width:15%;\" class=\"num\">Balance</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr class=\"opening\">\n        <td></td>\n        <td>{{ frappe.utils.formatdate(doc.posting_date) }}</td>\n        <td colspan=\"3\">Invoice amount</td>\n        <td class=\"num\"></td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(pay.invoice_amount, currency=doc.currency) }}</td>\n      </tr>\n      {% for p in pay.rows %}\n      <tr>\n        <td>{{ loop.index }}</td>\n        <td>{{ frappe.utils.formatdate(p.date) }}</td>\n        <td>{{ p.voucher_no }}</td>\n        <td>{{ p.mode }}</td>\n        <td>{{ p.reference or \"&mdash;\" }}</td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(p.amount, currency=doc.currency) }}</td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(p.balance, currency=doc.currency) }}</td>\n      </tr>\n      {% else %}\n      <tr><td class=\"empty\" colspan=\"7\">No payment received against this invoice yet.</td></tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <table class=\"pay-summary\">\n    <tr><td class=\"sp\"></td><td class=\"label\">Total Received</td><td class=\"amount\">{{ frappe.utils.fmt_money(pay.received, currency=doc.currency) }}</td></tr>\n    <tr class=\"bal {{ pay.tone }}\"><td class=\"sp\"></td><td class=\"label\">Balance Receivable</td><td class=\"amount\">{{ frappe.utils.fmt_money(pay.balance, currency=doc.currency) }}</td></tr>\n  </table>\n</div>\n{% endif %}\n\n<!-- ================= SIGNATURE ================= -->\n<table class=\"sign-table\">\n  <tr>\n    <td><div class=\"sign-line\">Customer Signature</div></td>\n    <td class=\"right\"><div class=\"sign-line\">For &mdash; {{ doc.company }}</div></td>\n  </tr>\n</table>\n",
