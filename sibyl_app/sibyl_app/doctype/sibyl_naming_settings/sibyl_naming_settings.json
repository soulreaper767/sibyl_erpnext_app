 "fields": [
  {
   "fieldname": "naming_section",
   "fieldtype": "Section Break",
   "label": "Customer-wise Naming"
  },
  {
   "default": "1",
   "description": "When off, all documents use their standard naming series.",
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enable Customer-wise Naming"
  },
  {
   "default": "{prefix}-{customer_id}-.####",
   "description": "Must contain {prefix}, {customer_id} and a run of #. Standard series tokens work too, e.g. {prefix}-{customer_id}-.YY.-.#### gives SO-ACME-26-0001 (counter then restarts every year).",
   "fieldname": "name_pattern",
   "fieldtype": "Data",
   "label": "Name Pattern",
   "reqd": 1
  },
  {
   "fieldname": "column_break_naming",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "preview",
   "fieldtype": "HTML",
   "label": "Preview"
  },
  {
   "fieldname": "customer_id_section",
   "fieldtype": "Section Break",
   "label": "Customer ID"
  },
  {
   "default": "Numeric",
   "description": "Numeric: 1001, 1002, 1003 ... so documents are named SO-1001-0001. From Customer Name: \"Acme Traders Pvt Ltd\" becomes ACME (ACME2 ... on clashes). After changing the mode, use Regenerate All Customer IDs to re-number existing customers and their documents.",
   "fieldname": "customer_id_mode",
   "fieldtype": "Select",
   "label": "Customer ID Mode",
   "options": "Numeric\nFrom Customer Name"
  },
  {
   "default": "4",
   "depends_on": "eval:doc.customer_id_mode=='From Customer Name'",
   "fieldname": "customer_id_length",
   "fieldtype": "Int",
   "label": "ID Length (letters from name)"
  },
  {
   "default": "1001",
   "depends_on": "eval:doc.customer_id_mode=='Numeric'",
   "description": "First customer gets this number, the next one +1.",
   "fieldname": "customer_id_start",
   "fieldtype": "Int",
   "label": "Starting Number"
  },
  {
   "default": "4",
   "depends_on": "eval:doc.customer_id_mode=='Numeric'",
   "description": "Minimum digits; shorter numbers are zero-padded (4 digits: 7 becomes 0007).",
   "fieldname": "customer_id_digits",
   "fieldtype": "Int",
   "label": "Digits"
  },
  {
   "depends_on": "eval:doc.customer_id_mode=='Numeric'",
   "description": "Optional letters before the number, e.g. C gives C1001. Leave blank for a plain number.",
   "fieldname": "customer_id_prefix",
   "fieldtype": "Data",
   "label": "ID Prefix (optional)"
  },
  {
   "fieldname": "column_break_cid",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "description": "Assign an ID automatically when a customer is saved without one (and for older customers the first time a document is raised). When off, a missing ID blocks the document.",
   "fieldname": "auto_assign_customer_id",
   "fieldtype": "Check",
   "label": "Auto-assign Customer ID"
  },
  {
   "fieldname": "rules_section",
   "fieldtype": "Section Break",
   "label": "Documents"
  },
  {
   "fieldname": "rules",
   "fieldtype": "Table",
   "label": "Naming Rules",
   "options": "Sibyl Naming Rule"
  },
  {
   "default": "0",
   "fieldname": "rules_seeded",
   "fieldtype": "Check",
   "hidden": 1,
   "label": "Rules Seeded"
  },
  {
